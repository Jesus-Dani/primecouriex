// Prime Couriex Express — data model (TRD §3).
// Field names and types follow the TRD's Booking/StaffUser/BookingStatusHistory/
// PricingConfig specification exactly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  process_serving
  registry_liaison
  corporate_courier
  same_day_delivery
  filing_compliance
}

enum DeliverySpeed {
  standard
  same_day
  urgent_express
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum BookingStatus {
  pending_review
  confirmed
  rejected
  in_transit
  delivered
  cancelled
}

model Booking {
  id                String  @id @default(uuid()) @db.Uuid
  reference_number  String  @unique // e.g. PCX-2026-000123 — TRD Appendix A
  service_type      ServiceType
  delivery_speed    DeliverySpeed

  // Contact & routing
  customer_name        String
  company_name         String?
  phone                String
  whatsapp_number      String
  email                String
  pickup_address       String
  pickup_lat           Float?
  pickup_lng           Float?
  pickup_contact_name  String
  pickup_contact_phone String
  delivery_address     String
  delivery_lat         Float?
  delivery_lng         Float?
  recipient_name       String
  recipient_phone      String

  // Package details
  package_description   String
  weight_kg              Float
  package_count           Int
  delivery_instructions  String?
  preferred_pickup_date  DateTime
  preferred_delivery_date DateTime?
  additional_notes       String?

  // Legal / process-serving fields (populated only when service_type = process_serving)
  legal_court_name       String?
  legal_suit_case_number String?
  legal_process_document String?
  legal_client_address   String?
  legal_company_name     String?
  legal_landmark         String?
  return_copy_addon      Boolean @default(false)

  // Pricing — computed once at submission, never silently recalculated (TRD §4).
  // distance_km / base_price / total_price are nullable to represent the Google
  // Maps fallback path (TRD §5): an ungeocodable address still submits, with
  // price left null ("to be confirmed") for staff to calculate manually.
  distance_km      Float?
  base_price       Int?
  urgent_surcharge Int    @default(0)
  addon_total      Int    @default(0)
  total_price      Int?

  // Payment
  payment_status    PaymentStatus @default(unpaid)
  paystack_reference String?

  // Review / workflow
  status                BookingStatus @default(pending_review)
  rejection_reason      String?
  notified_at           DateTime?
  notified_by_staff_id  String?   @db.Uuid
  notified_by_staff     StaffUser? @relation("NotifiedBookings", fields: [notified_by_staff_id], references: [id])
  confirmed_by_staff_id String?   @db.Uuid
  confirmed_by_staff    StaffUser? @relation("ConfirmedBookings", fields: [confirmed_by_staff_id], references: [id])

  // Consent / NDPR (PRD §9.3, §14.2)
  client_confirmation_accepted Boolean
  data_consent_accepted        Boolean
  data_consent_timestamp       DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  status_history BookingStatusHistory[]

  @@index([status])
  @@index([service_type])
  @@index([created_at])
}

model StaffUser {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("staff") // single role in v1; reserved for future RBAC (TRD §7, §14)
  created_at    DateTime @default(now())

  notified_bookings         Booking[]               @relation("NotifiedBookings")
  confirmed_bookings        Booking[]               @relation("ConfirmedBookings")
  booking_status_changes    BookingStatusHistory[]
}

model BookingStatusHistory {
  id                 String         @id @default(uuid()) @db.Uuid
  booking_id         String         @db.Uuid
  booking            Booking        @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  from_status        BookingStatus?
  to_status          BookingStatus
  changed_by_staff_id String        @db.Uuid
  changed_by_staff    StaffUser     @relation(fields: [changed_by_staff_id], references: [id])
  note               String?
  created_at         DateTime       @default(now())

  @@index([booking_id])
}

// Key/value pricing settings so the business can adjust figures without a
// code deploy (TRD §3.2). Seeded with the locked v1 values — see prisma/seed.ts.
model PricingConfig {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  value      Int
  updated_at DateTime @updatedAt
}
