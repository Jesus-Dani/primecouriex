# Copy this file to .env.local (local dev) and fill in real values.
# Never commit .env.local with real secrets — see TRD §11.1.
#
# NOTE: this project uses Supabase (Postgres + Auth) via the Supabase JS SDK
# instead of the TRD's originally specified Prisma + NextAuth/Lucia stack —
# a deliberate, client-approved deviation from TRD §2/§3/§7. See README.md.

# Supabase project URL (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase publishable/anon key (Project Settings → API). Safe to expose to the
# browser — used only for staff auth session cookies (@supabase/ssr), RLS
# restricts everything else. Never used to read/write booking data directly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-anon-key"

# Supabase service role key (Project Settings → API). SERVER-SIDE ONLY — bypasses
# Row Level Security. Used in Server Actions/Route Handlers for booking writes
# and the admin dashboard. Must NEVER be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Server-side Google Maps key for Routes API distance lookups (TRD §5, §11.1).
# Must NEVER be exposed to the browser — used only in server actions / API routes.
GOOGLE_MAPS_SERVER_KEY="replace-with-google-maps-server-key"

# Browser-side Google Maps key for Places Autocomplete, restricted by HTTP referrer (TRD §5, §11.1).
# Safe to expose to the client — must be locked down in Google Cloud Console to your site's domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_CLIENT_KEY="replace-with-google-maps-client-key"

# Paystack secret key — server-side only, used for payment init and webhook/transaction verification (TRD §6, §11.1).
PAYSTACK_SECRET_KEY="sk_test_replace-with-paystack-secret-key"

# Paystack public key — used by the client-side Paystack Inline checkout widget (TRD §6, §11.1).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace-with-paystack-public-key"
